# 每个 ChatServer 实例必须使用不同节点 ID；Redis 路由和 RabbitMQ routing key 依赖它。
CHAT_SERVER_ID=server-1

# MySQL 保存账户关系和离线消息。生产环境请通过密钥系统注入密码，不要提交真实值。
CHAT_MYSQL_HOST=127.0.0.1
CHAT_MYSQL_PORT=3306
CHAT_MYSQL_USER=root
CHAT_MYSQL_PASSWORD=change-me
CHAT_MYSQL_DATABASE=chat

# Redis 保存在线路由租约与 message_id 去重键。
CHAT_REDIS_HOST=127.0.0.1
CHAT_REDIS_PORT=6379

# RabbitMQ 在不同 ChatServer 节点间转发在线消息；所有节点必须使用同一 exchange。
CHAT_RABBITMQ_HOST=127.0.0.1
CHAT_RABBITMQ_PORT=5672
CHAT_RABBITMQ_USER=chat
CHAT_RABBITMQ_PASSWORD=change-me
CHAT_RABBITMQ_EXCHANGE=chat_cross_server

# Web 网关监听浏览器请求，并把每条 WebSocket 连接桥接到指定 C++ TCP 节点。
CHAT_WEB_PORT=8080
CHAT_BACKEND_HOST=127.0.0.1
CHAT_BACKEND_PORT=6000
